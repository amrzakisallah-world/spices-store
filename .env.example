# Server port (must be 3000 in AI Studio preview)
PORT=3000

# SQLite database file path
DATABASE_PATH="./data/spices-store.db"

# Session signing secret (set a long random string in production)
SESSION_SECRET="change-me-to-a-long-random-secret-in-production"

# Initial Admin / Store Owner credentials (used only when no users exist yet)
ADMIN_NAME="مدير المتجر"
ADMIN_EMAIL="admin@omaryounis.com"
ADMIN_INITIAL_PASSWORD="ChangeMe123!"
# Optional secret key to allow resetting forgotten admin password from /admin login page
ADMIN_RESET_KEY=""

# Storefront & WhatsApp integration (Egyptian format without +, e.g., 201001234567)
# Leave empty if not yet configured
WHATSAPP_NUMBER=""
STORE_PHONE=""
STORE_ADDRESS="القاهرة، مصر"

# Delivery defaults (EGP)
DEFAULT_DELIVERY_FEE_EGP=45
FREE_DELIVERY_THRESHOLD_EGP=600
